<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_contact_card"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/celula_tv_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_contact_icon"
        android:gravity="center"
        android:text="@string/contact_icon_text"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/celula_tv_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Samsung"
            android:textColor="@color/textPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/celula_tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Identificador"
            android:textColor="@color/textSecondaryDark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/celula_tv_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/device_presence_unknown"
            android:textColor="@color/presenceUnknown"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/celula_btn_identificar"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_remote_button_oneui"
        android:ellipsize="end"
        android:focusable="false"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="@string/contact_identify_device"
        android:textAllCaps="false"
        android:textColor="@color/textPrimaryDark"
        android:textSize="11sp" />

</LinearLayout>
